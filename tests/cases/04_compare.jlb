>> Comparisons: ==, ===, their opposites, <, >, <==, >==
PRINT("25" == 25)
PRINT("025" == 25)
PRINT("25" === 25)
PRINT(25 === 25)
PRINT("25" !== 25)
PRINT("25" !=== 25)
PRINT("025" == "25")
PRINT("25" > 24)
PRINT("abc" > "ab")
PRINT("5" > "3")
PRINT("abc" <= "xyz")
PRINT("abc" <== "xyz")
PRINT("abc" <== "abc")
PRINT("ab" <== "xyz")
PRINT(3 <== 3)
PRINT(TRUE == 1)
PRINT(TRUE === 1)
PRINT(NULL == 0)
PRINT(NULL === 0)
PRINT(NULL == NULL)
PRINT(NULL == "")
PRINT("TRUE" == TRUE)
PRINT("1" == TRUE)
PRINT("TRUE" === TRUE)
PRINT("1e3" == 1000)
PRINT("0xFF" > 200)
a = [1, 2]
b = a
c @= a
PRINT(a == b)
PRINT(a === b)
PRINT(a === c)
PRINT(5 > 3)
TRY { PRINT("hello" > 3) } FAIL e { PRINT(e.message) }
