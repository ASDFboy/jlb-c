>> Functions, scope, LOCAL, GLOBAL, function_name.var, optional and any-number inputs, functions as values
score = 10
count = 3
enemies = ["a", "b", "c", "d"]
DEF count_enemies(amount) {
    GLOBAL score += amount
    LOCAL count = 0
    FOR e IN enemies {
        count += 1
    }
    PRINT("inside: " + count_enemies.count)
    RETURN count
}
PRINT(count_enemies(5))
PRINT(count)
PRINT(score)
DEF add_points(amount) {
    bonus = amount * 2
    RETURN bonus
}
PRINT(add_points(5))
TRY { PRINT(bonus) } FAIL e { PRINT(e.message) }
DEF outer() { LOCAL secret = 42; RETURN inner() }
DEF inner() { RETURN outer.secret }
PRINT(outer())
TRY { PRINT(outer.secret) } FAIL e { PRINT(e.message) }
DEF greet(name, greeting = "Hi") { RETURN greeting + ", " + name }
PRINT(greet("Alex"))
PRINT(greet("Alex", "Hello"))
PRINT(greet("Alex", NULL))
TRY { greet() } FAIL e { PRINT(e.message) }
TRY { greet(1, 2, 3) } FAIL e { PRINT(e.message) }
DEF total(...nums) { LOCAL sum = 0; FOR n IN nums { sum += n }; RETURN sum }
PRINT(total(1, 2, 3))
PRINT(total())
FUNC say_hi() { PRINT("hi") }   >> FUNC is the older name for DEF
g = say_hi
g()
DEF do_twice(action) { action(); action() }
do_twice(say_hi)
double = DEF(x) { RETURN x * 2 }
PRINT(double(5))
PRINT(say_hi)
PRINT(double)
DEF fact(n) { IF n <= 1 { RETURN 1 }; RETURN n * fact(n - 1) }
PRINT(fact(10))
DEF no_return() { x = 1 }
PRINT(no_return())
DEF show_local() {
    LOCAL v
    PRINT(v)
    v = 5
    RETURN v
}
PRINT(show_local())
