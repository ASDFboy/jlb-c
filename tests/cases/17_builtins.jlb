>> Built-in commands
PRINT(ABS(-5))
PRINT(MIN(3, 1, 2), MAX(3, 1, 2))
PRINT(TABLE_MIN([3, 9, 2]))
PRINT(TABLE_MAX([3, [20], 9]))
PRINT(TABLE_MAX([3, [20], 9], 1))
PRINT(SIN(90), COS(90), SIN(30), TAN(45))
PRINT(CSC(90), SEC(0), COT(45))
PRINT(ASIN(1), ACOS(1), ATAN(1, 1))
PRINT(RAD_SIN(PI() / 2), RAD_COS(0))
PRINT(PI(2))
PRINT(ROUND(3.14159), ROUND(3.14159, 2), FLOOR(3.789, 1), CEIL(3.201, 1))
TRY { TAN(90) } FAIL e { PRINT(e.message) }
PRINT(UPPER("alex"), LOWER("ALEX"))
PRINT(SPLIT("a,b,c", ","))
PRINT(SPLIT("hey", ""))
PRINT(JOIN(["a", "b"], ", "))
PRINT(FIND("hello", "l"))
PRINT(FIND("hello", "z"))
t = ["apple", inv: ["sword", "shield"]]
PRINT(FIND(t, "apple"))
PRINT(FIND(t, "shield"))
PRINT(FIND(t, "shield", 1))
PRINT(FIND([25], "25"))
PRINT(FIND([[1, 2], [3]], [3]))
PRINT(KEYS([name: "Alex", score: 10]))
PRINT(ENG(1500), ENG(15000), ENG(0.002))
PRINT(HEX(255), HEX(-26))
TRY { HEX(2.5) } FAIL e { PRINT(e.message) }
PRINT(STR([1, "a"]))
PRINT(RANDOM(1, 10, NULL, 42) == RANDOM(1, 10, NULL, 42))
r = RANDOM(1, 10)
PRINT(r >= 1 & r <= 10 & ROUND(r) == r)
r = RANDOM(1, 2.5)
PRINT(r >= 1 & r <= 2.5 & ROUND(r, 1) == r)
r = RANDOM(0, 1, 3)
PRINT(r >= 0 & r <= 1 & ROUND(r, 3) == r)
PRINT(TYPE(TIME()), TYPE(DELTA_TIME(3)))
WAIT(0.01)
PRINT(TIME() > 0)
