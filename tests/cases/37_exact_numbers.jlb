>> Exact numbers: decimals and fractions never pick up rounding errors,
>> and numbers grow to as many digits as they need.
PRINT(0.1 + 0.2, 0.1 + 0.2 == 0.3, 0.3 % 0.1, 19.99 * 3, 1.1 ^ 10)
PRINT(1 / 3, 2 / 3, 1 / 3 * 3, -1 / 7, 100 / 3)
PRINT(1 / 30000, 10 ^ 20 / 3)
total = 0
REPEAT 10 { total += 0.1 }
PRINT(total, total === 1)

>> Big and tiny
PRINT(2 ^ 100, 9223372036854775807 + 1, -9223372036854775807 - 2)
PRINT(1e20, 1e-7, 2 ^ -10, 0xFFFFFFFFFFFFFFFFFFFF, HEX(2 ^ 80))
PRINT(12345678901234567890 * 98765432109876543210)
PRINT(98765432109876543210123 !% 1234567890123, 98765432109876543210123 % 1234567890123)
PRINT(LEN(STR(2 ^ 1000)), LEN(STR(1 / 2 ^ 100)))

>> Roots and powers are exact when the answer is
PRINT(16 !^ 2, (-27) !^ 3, 0.25 !^ 2, (2 ^ 100) !^ 100, 8 ^ (2 / 3), 4 ^ -0.5)
>> ...and approximate when it can't be written exactly
PRINT(2 !^ 2, 2 !^ 2 * 2 !^ 2, ROUND(2 !^ 2 * 2 !^ 2, 10))

>> Rounding gives exact results
PRINT(ROUND(1 / 3, 5), ROUND(-2.5), FLOOR(-1.5), CEIL(1.0001, 2), PI(30), ROUND(PI(), 4))
PRINT(SIN(30), COS(60) == 0.5, ENG(1 / 3), ENG(2 ^ 70))

>> Counting loops step exactly
FOR x IN 0 TO 0.5 STEP 0.1 { PRINT(x) }
FOR x IN 1 TO 0 STEP 1 / 3 { PRINT(x) }

>> Long calculations: forever-decimals keep 50 significant decimals
x = 1
FOR i IN 1 TO 30 { x = (x + 2 / x) / 2 }
PRINT(x)

>> Text that looks like a number converts exactly too
PRINT(NUM("0.1") + NUM("0.2"), "0.3" == 0.1 + 0.2, NUM("1e30"))
PRINT(SORT([3, 1 / 3, 0.3, -2, 2 ^ 70, 0.33]))
TRY { x = 10 ^ 2000000 } FAIL e { PRINT(e.message) }
