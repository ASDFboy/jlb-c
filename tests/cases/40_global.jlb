>> Names given a value inside a function are its own, unless GLOBAL comes first
score = 10
name = "outside"
DEF play() {
    score = 99               >> a new local: the outside score stays 10
    PRINT("inside:", score, name)
    GLOBAL name = "changed"  >> the outside name
    GLOBAL lives = 3         >> a new outside name
    GLOBAL lives -= 1
    DEF helper() { RETURN "helper" }
    GLOBAL DEF shared() { RETURN "shared" }
    DEF GLOBAL also_shared() { RETURN "also shared" }
    GLOBAL CONST limit_note = "constant"
    PRINT(helper())
    RETURN score
}
PRINT(play(), score, name, lives)
PRINT(shared(), also_shared(), limit_note)
TRY { PRINT(helper()) } FAIL e { PRINT(e.message) }
DEF bump() { score += 1 }
TRY { bump() } FAIL e { PRINT(e.message) }
DEF bump_outside() { GLOBAL score += 1 }
bump_outside()
PRINT(score)
>> Entries of an outside table can still be changed
hero = [hp: 5]
DEF heal() { hero.hp += 10 }
heal()
PRINT(hero.hp)
>> Sharing with @= is local too, unless GLOBAL
pool = [1, 2]
DEF link() {
    mine @= pool
    mine += 3
    GLOBAL alias @= pool
}
link()
PRINT(pool, alias)
CONST fixed = 1
DEF try_fixed() { GLOBAL fixed = 2 }
TRY { try_fixed() } FAIL e { PRINT(e.message) }
DEF no_outside() { GLOBAL missing += 1 }
TRY { no_outside() } FAIL e { PRINT(e.message) }
>> At the top of the file, GLOBAL changes nothing
GLOBAL top = "top"
PRINT(top)
